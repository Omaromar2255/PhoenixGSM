<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PhoenixGSM.MonitoringStudio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DevConfigStudio</AssemblyName>
    <BaseOutputPath>C:\Users\pc5\Documents\GitHub\PhoenixGSMtools\</BaseOutputPath>
  </PropertyGroup>

  <Target Name="CopyOutputAlias" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)DevConfigStudio.exe" DestinationFiles="$(TargetDir)MonitoringStudio.exe" Condition="Exists('$(TargetDir)DevConfigStudio.exe')" />
    <Copy SourceFiles="$(TargetDir)DevConfigStudio.dll" DestinationFiles="$(TargetDir)MonitoringStudio.dll" Condition="Exists('$(TargetDir)DevConfigStudio.dll')" />
    <Copy SourceFiles="$(TargetDir)DevConfigStudio.runtimeconfig.json" DestinationFiles="$(TargetDir)MonitoringStudio.runtimeconfig.json" Condition="Exists('$(TargetDir)DevConfigStudio.runtimeconfig.json')" />
    <Copy SourceFiles="$(TargetDir)DevConfigStudio.deps.json" DestinationFiles="$(TargetDir)MonitoringStudio.deps.json" Condition="Exists('$(TargetDir)DevConfigStudio.deps.json')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\UsbMonitor\UsbMonitor\UsbMonitor.csproj" />
    <ProjectReference Include="..\UsbMonitor\UsbMonitorDiscovery\UsbMonitorDiscovery.csproj" />
    <ProjectReference Include="..\SerialSniffer\SerialSniffer.csproj" />
    <ProjectReference Include="..\ProcessMonitor\ProcessMonitor.csproj" />
    <ProjectReference Include="..\CommandAnalyzer\CommandAnalyzer.csproj" />
    <ProjectReference Include="..\AdbMonitor\AdbMonitor.csproj" />
    <ProjectReference Include="..\PhoenixOmniTrace\PhoenixOmniTrace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PhoenixOmniTrace\L24_SourceSentinel\UI\**\*.cs" Link="L24_SourceSentinel\UI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\PhoenixOmniTrace\L24_SourceSentinel\UI\**\*.xaml" Link="L24_SourceSentinel\UI\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
