<Window x:Class="PhoenixGSM.MonitoringStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhoenixGSM.MonitoringStudio.ViewModels"
        xmlns:comp="clr-namespace:PhoenixGSM.MonitoringStudio.Views.Components"
        mc:Ignorable="d"
        Title="Device Configuration Utility" 
        Height="850" Width="1380"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding ClearLogsCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding ExportLogsCommand}" />
    </Window.InputBindings>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Compact Metrics Dashboard Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2: View Mode Switcher Tab Bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Compact Sensors & Categories Control Panel (General View Only) -->
            <RowDefinition Height="Auto" />
            <!-- 4: Main Stream & Inspector Split View -->
            <RowDefinition Height="*" />
            <!-- 5: Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header & Action Toolbar -->
        <comp:HeaderActionBarView Grid.Row="0" Margin="0,0,0,8" />

        <!-- ROW 1: Metrics Dashboard Cards (Compact Height ~46px) -->
        <comp:MetricsDashboardView Grid.Row="1" Margin="0,0,0,8" />

        <!-- ROW 2: View Navigation Switcher Bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab 1: General Forensic Stream -->
                    <RadioButton Content="🌐 التدفق الجنائي الشامل" 
                                 IsChecked="{Binding IsGeneralForensicViewActive, Mode=OneWay}"
                                 Command="{Binding SwitchToGeneralViewCommand}"
                                 GroupName="ViewTabs"
                                 Style="{StaticResource TabRadioBtn}" Margin="0,0,6,0"
                                 ToolTip="عرض البث الجنائي الكامل لكافة الأجهزة والعمليات (All Forensic Events)" />

                    <!-- Tab 2: Dedicated Technician to Phone Audit -->
                    <RadioButton IsChecked="{Binding IsTechnicianAuditViewActive, Mode=OneWay}"
                                 Command="{Binding SwitchToTechnicianAuditViewCommand}"
                                 GroupName="ViewTabs"
                                 Style="{StaticResource TabRadioBtn}" Margin="0,0,6,0"
                                 ToolTip="سجل تدقيق الأوامر الحقيقية المنفذة على هاتف العميل فقط (Technician ➔ Phone Audit)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ أوامر الفني لهاتف العميل" FontWeight="Bold" Foreground="#00FFC2" VerticalAlignment="Center" />
                            <Border Background="{Binding TechnicianAuditTabBadgeBg}" BorderBrush="{Binding TechnicianAuditTabBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TechnicianAuditTabBadgeText}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding TechnicianAuditTabBadgeForeground}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: Dedicated Tool-Source Command Interception (MTP, MTK, Odin, Port) -->
                    <RadioButton IsChecked="{Binding IsToolSourceInterceptionViewActive, Mode=OneWay}"
                                 Command="{Binding SwitchToToolSourceViewCommand}"
                                 GroupName="ViewTabs"
                                 Style="{StaticResource TabRadioBtn}"
                                 ToolTip="اعتراض أوامر الأدوات من المصدر (Tool-Source: MTP / MTK / Odin / Port)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ أوامر الأدوات من المصدر" FontWeight="Bold" Foreground="#00FFE5" VerticalAlignment="Center" />
                            <Border Background="#002E2E" BorderBrush="#00FFE5" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToolSourceTotalCount, StringFormat='{}{0} Cmds'}" FontWeight="Bold" FontSize="10.5" Foreground="#00FFE5" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Pop-out Window & Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- UNIFIED L24 RADAR & POWER HUB (ALWAYS FIRST & PROMINENT) -->
                    <Border Background="#161B28" BorderBrush="{Binding L24MasterButtonBorder}" 
                            BorderThickness="1" CornerRadius="5" Height="26" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 1. Open L24 Radar Window Button -->
                            <Button Command="{Binding OpenSourceSentinelWindowCommand}"
                                    Foreground="#00FFE5" FontWeight="Bold" FontSize="11"
                                    Padding="9,0" Height="24" Cursor="Hand"
                                    ToolTip="فتح نافذة رادار واعتراض المصدر المستقلة (L24 Source Sentinel)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4,0,0,4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#252F48" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ فتح رادار المصدر L24" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Vertical Divider -->
                            <Rectangle Width="1" Fill="#2F364E" Height="16" VerticalAlignment="Center" />

                            <!-- 2. Power Toggle Button -->
                            <Button Command="{Binding ToggleL24ActiveCommand}"
                                    Foreground="{Binding L24MasterStatusColor}"
                                    FontWeight="Bold" FontSize="10"
                                    Padding="7,0" Height="24" Cursor="Hand"
                                    ToolTip="{Binding L24MasterTooltip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{Binding L24MasterButtonBackground}" CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding L24MasterStatusText}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Pop-out Technician Audit Window -->
                    <Button Content="🗗 نافذة الفني" 
                            Command="{Binding OpenTechnicianAuditWindowCommand}" 
                            Style="{StaticResource ModernBtn}" Height="26" FontSize="10.5" Padding="8,2" Margin="0,0,6,0"
                            ToolTip="فتح أوامر الفني لهاتف العميل بنافذة مستقلة" />

                    <!-- Source Logs Folder -->
                    <Button Content="📁 السجلات" 
                            Command="{Binding OpenToolSourceLogFolderCommand}" 
                            Style="{StaticResource ModernBtn}" Height="26" FontSize="10.5" Padding="8,2"
                            ToolTip="فتح مجلد سجلات التقاط الأدوات والمصدر" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: Granular Capture Sensors & Exclusions Panel (Visible only in General Forensic View) -->
        <comp:SensorsFilterBarView Grid.Row="3" Margin="0,0,0,8"
                                   Visibility="{Binding IsGeneralForensicViewActive, Converter={StaticResource BoolToVis}}" />

        <!-- ROW 4: Main Stream Views -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <!-- GENERAL SPLIT VIEW -->
            <Grid Visibility="{Binding IsGeneralForensicViewActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Live Event Stream Table (Top 60%) -->
                    <RowDefinition x:Name="StreamRow" Height="60*" MinHeight="160" />
                    <!-- Draggable Splitter -->
                    <RowDefinition Height="6" />
                    <!-- Detailed Inspector Drawer (Bottom 40%) -->
                    <RowDefinition x:Name="InspectorRow" Height="40*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- LIVE DATA GRID -->
                <comp:EventsGridView x:Name="EventsGridComp" Grid.Row="0" />

                <!-- DRAGGABLE SPLITTER -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" 
                              Background="#121622" Cursor="SizeNS" ShowsPreview="True" />

                <!-- PACKET & PROTOCOL INSPECTOR DRAWER -->
                <comp:InspectorDrawerView x:Name="InspectorComp" Grid.Row="2" />
            </Grid>

            <!-- DEDICATED SEPARATE TECHNICIAN COMMAND AUDIT VIEW -->
            <comp:TechnicianAuditView Visibility="{Binding IsTechnicianAuditViewActive, Converter={StaticResource BoolToVis}}" />

            <!-- DEDICATED SEPARATE TOOL-SOURCE COMMAND INTERCEPTION VIEW (MTP / MTK / ODIN / PORT) -->
            <comp:ToolSourceInterceptionView Visibility="{Binding IsToolSourceInterceptionViewActive, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ROW 5: STATUS FOOTER BAR -->
        <comp:StatusBarFooterView Grid.Row="5" />
    </Grid>
</Window>
