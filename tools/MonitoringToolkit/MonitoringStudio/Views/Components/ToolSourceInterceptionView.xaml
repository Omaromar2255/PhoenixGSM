<UserControl x:Class="PhoenixGSM.MonitoringStudio.Views.Components.ToolSourceInterceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:PhoenixGSM.MonitoringStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Layer Banner, Filter Chips & Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Dedicated Tool-Source Commands Stream Table (60%) -->
            <RowDefinition Height="60*" MinHeight="180" />
            <!-- 2: Draggable Splitter -->
            <RowDefinition Height="6" />
            <!-- 3: Dedicated Inspector Drawer (40%) -->
            <RowDefinition Height="40*" MinHeight="140" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 0: LAYER BANNER, FILTER CHIPS & CONTROLS                   -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sub-row 0: Title, Persistence Indicator & Master Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Auto-Save Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="التقاط الأوامر من مصدر الأداة (Tool-Source Interception)" FontSize="13" FontWeight="Bold" Foreground="#00FFE5" VerticalAlignment="Center" />
                        <TextBlock Text="(MTP • MTK BROM • Odin • Port/COM)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />

                        <!-- Auto-Save Badge -->
                        <Border Background="#002E2E" BorderBrush="#00FFE5" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center"
                                ToolTip="{Binding ToolSourceAutoSavePathDisplay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-Save Active (JSONL &amp; LOG)" FontSize="10" FontWeight="Bold" Foreground="#00FFE5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Search Filter Box -->
                    <Grid Grid.Column="1" HorizontalAlignment="Right" Width="260" Margin="0,0,10,0">
                        <TextBox Text="{Binding ToolSourceSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0C0F17" Foreground="#FFFFFF" BorderBrush="#2A3347" 
                                 CaretBrush="#00FFE5" Padding="8,3" FontSize="11" Height="26" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="🔍 Filter tool commands..." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToolSourceSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ToolSourceSearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Auto-Scroll Toggle Button -->
                        <Button Command="{Binding ToggleAutoScrollCommand}" 
                                Height="26" FontSize="10.5" Padding="8,2" Margin="0,0,5,0"
                                ToolTip="تشغيل أو إيقاف التمرير التلقائي لآخر أمر">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernBtn}">
                                    <Setter Property="Background" Value="#171C28" />
                                    <Setter Property="BorderBrush" Value="#2A3347" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoScroll}" Value="True">
                                            <Setter Property="Background" Value="#0A2E25" />
                                            <Setter Property="BorderBrush" Value="#00FF9D" />
                                            <Setter Property="Foreground" Value="#00FF9D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AutoScrollIcon}" Margin="0,0,4,0" FontSize="10.5"/>
                                <TextBlock Text="التمرير التلقائي" />
                            </StackPanel>
                        </Button>

                        <!-- Clear Button -->
                        <Button Content="🗑️ مسح الجدول" 
                                Command="{Binding ClearToolSourceCommand}" 
                                Style="{StaticResource ModernBtn}" 
                                Height="26" FontSize="10.5" Padding="8,2" Margin="0,0,5,0"
                                ToolTip="مسح السجلات المعروضة في الجدول (تبقى محفوظة في الملفات)" />

                        <!-- Open Folder Button -->
                        <Button Content="📁 مجلد السجلات" 
                                Command="{Binding OpenToolSourceLogFolderCommand}" 
                                Style="{StaticResource ModernBtn}" 
                                Height="26" FontSize="10.5" Padding="8,2" Margin="0,0,5,0"
                                ToolTip="فتح مجلد حفظ سجلات أوامر الأدوات في مستكشف ويندوز" />

                        <!-- Export Button -->
                        <Button Content="💾 تصدير الأوامر" 
                                Command="{Binding ExportToolSourceCommand}" 
                                Style="{StaticResource CyanActionBtn}" 
                                Height="26" FontSize="10.5" Padding="10,2"
                                ToolTip="تصدير الأوامر الملتقطة إلى ملف نصي أو JSON" />
                    </StackPanel>
                </Grid>

                <!-- Sub-row 1: Mode Filter Chips with Real-Time Counters -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="-3,2,-3,0">
                    <!-- 1. All Modes Chip -->
                    <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="26">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171C28" />
                                <Setter Property="BorderBrush" Value="#232B3B" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#38455E" />
                                        <Setter Property="Background" Value="#1C2232" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToolSourceAllSelected}" Value="True">
                                        <Setter Property="Background" Value="#002E2E" />
                                        <Setter Property="BorderBrush" Value="#00FFE5" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectToolSourceModeCommand}" CommandParameter="ALL"
                                Style="{StaticResource TransparentBtn}" BorderThickness="0" Padding="8,2" ToolTip="عرض جميع الأوامر الملتقطة">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐 All Modes" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolSourceTotalCount}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 2. MTP Mode Chip -->
                    <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="26">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171C28" />
                                <Setter Property="BorderBrush" Value="#232B3B" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#00B0FF" />
                                        <Setter Property="Background" Value="#1C2232" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToolSourceMtpSelected}" Value="True">
                                        <Setter Property="Background" Value="#002B4D" />
                                        <Setter Property="BorderBrush" Value="#00B0FF" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectToolSourceModeCommand}" CommandParameter="MTP"
                                Style="{StaticResource TransparentBtn}" BorderThickness="0" Padding="8,2" ToolTip="تصفية أوامر وضع نقل الملفات MTP/PTP">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📱 MTP Mode" Foreground="#00B0FF" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#00B0FF" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolSourceMtpCount}" FontSize="9.5" FontWeight="Bold" Foreground="#00B0FF" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 3. MTK BROM Mode Chip -->
                    <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="26">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171C28" />
                                <Setter Property="BorderBrush" Value="#232B3B" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF6D00" />
                                        <Setter Property="Background" Value="#1C2232" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToolSourceMtkSelected}" Value="True">
                                        <Setter Property="Background" Value="#4A1C00" />
                                        <Setter Property="BorderBrush" Value="#FF6D00" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectToolSourceModeCommand}" CommandParameter="MTK"
                                Style="{StaticResource TransparentBtn}" BorderThickness="0" Padding="8,2" ToolTip="تصفية أوامر ميديا تيك BROM و Preloader و DA">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ MTK BROM" Foreground="#FF6D00" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#FF6D00" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolSourceMtkCount}" FontSize="9.5" FontWeight="Bold" Foreground="#FF6D00" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 4. Samsung Odin Mode Chip -->
                    <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="26">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171C28" />
                                <Setter Property="BorderBrush" Value="#232B3B" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#00FF9D" />
                                        <Setter Property="Background" Value="#1C2232" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToolSourceOdinSelected}" Value="True">
                                        <Setter Property="Background" Value="#0D2E1C" />
                                        <Setter Property="BorderBrush" Value="#00FF9D" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectToolSourceModeCommand}" CommandParameter="ODIN"
                                Style="{StaticResource TransparentBtn}" BorderThickness="0" Padding="8,2" ToolTip="تصفية أوامر سامسونج داونلود وأودين (Loke Protocol)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👑 Samsung Odin" Foreground="#00FF9D" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolSourceOdinCount}" FontSize="9.5" FontWeight="Bold" Foreground="#00FF9D" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 5. Serial / COM Port Chip -->
                    <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="26">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#171C28" />
                                <Setter Property="BorderBrush" Value="#232B3B" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFB800" />
                                        <Setter Property="Background" Value="#1C2232" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToolSourcePortSelected}" Value="True">
                                        <Setter Property="Background" Value="#4D3B00" />
                                        <Setter Property="BorderBrush" Value="#FFB800" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectToolSourceModeCommand}" CommandParameter="PORT"
                                Style="{StaticResource TransparentBtn}" BorderThickness="0" Padding="8,2" ToolTip="تصفية أوامر المنافذ التسلسلية وأوامر AT المباشرة">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📟 Port / COM" Foreground="#FFB800" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#FFB800" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolSourcePortCount}" FontSize="9.5" FontWeight="Bold" Foreground="#FFB800" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 1: DEDICATED TOOL-SOURCE COMMAND STREAM DATAGRID           -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="ToolSourceGrid"
                      ItemsSource="{Binding FilteredToolSourceRecords}"
                      SelectedItem="{Binding SelectedToolSourceRecord, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E2433"
                      VerticalGridLinesBrush="Transparent"
                      Background="Transparent"
                      RowBackground="#0E121D"
                      AlternatingRowBackground="#121724"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      FontSize="11.5"
                      RowHeight="26"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#171C28" />
                        <Setter Property="Foreground" Value="#00FFE5" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderBrush" Value="#252E42" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F3547" />
                                <Setter Property="BorderBrush" Value="#00FFE5" />
                                <Setter Property="BorderThickness" Value="0,1,0,1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#182336" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Column 1: ID -->
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 2: Time -->
                    <DataGridTextColumn Header="الوقت (Time)" Binding="{Binding TimeFormatted}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64B5F6" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="10.5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 3: Tool & PID -->
                    <DataGridTemplateColumn Header="الأداة (Tool &amp; PID)" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️ " FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProcessId, StringFormat=' ({0})'}" Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column 4: Mode Badge -->
                    <DataGridTemplateColumn Header="الوضع (Mode)" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ModeBadgeBackground}" 
                                        BorderBrush="{Binding ModeBadgeForeground}"
                                        BorderThickness="1" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModeName}" FontWeight="Bold" FontSize="10" Foreground="{Binding ModeBadgeForeground}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column 5: Intercept API -->
                    <DataGridTemplateColumn Header="آلية الاعتراض (API)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InterceptMechanism}" Foreground="{Binding InterceptBadgeForeground}" 
                                           FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column 6: Target / Port -->
                    <DataGridTextColumn Header="الهدف / المنفذ (Target)" Binding="{Binding TargetEndpoint}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFE082" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="10.5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 7: Pure Command (Primary) -->
                    <DataGridTemplateColumn Header="الأمر المنفذ من المصدر (Pure Command)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PureCommand}" FontWeight="Bold" Foreground="#00FFE5" 
                                           FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column 8: Payload Size -->
                    <DataGridTextColumn Header="الحجم (Size)" Binding="{Binding PayloadSize, StringFormat='{}{0} B'}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 9: Risk Badge -->
                    <DataGridTemplateColumn Header="الخطورة (Risk)" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RiskBackground}" 
                                        BorderBrush="{Binding RiskColor}"
                                        BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RiskLevel}" FontWeight="Bold" FontSize="9" Foreground="{Binding RiskColor}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: DRAGGABLE SPLITTER                                      -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" 
                      Background="#121622" Cursor="SizeNS" ShowsPreview="True" />

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 3: DEDICATED INSPECTOR DRAWER                              -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Inspector Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔬" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Tool-Source Command Deep Inspector" FontSize="11.5" FontWeight="Bold" Foreground="#00FFE5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedToolSourceRecord.PureCommand, StringFormat=' — {0}'}" 
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" 
                                   MaxWidth="500" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋 نسخ الأمر النقي" 
                                Command="{Binding CopyToolSourceCommandTextCommand}" 
                                Style="{StaticResource ModernBtn}" Height="23" FontSize="10" Padding="8,1" />
                    </StackPanel>
                </Grid>

                <!-- Tabbed Inspector Content -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="FontSize" Value="10.5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#002E2E" />
                                                <Setter Property="Foreground" Value="#00FFE5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: Forensic Details -->
                    <TabItem Header="📋 التفاصيل الفنية (Forensics)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox Text="{Binding SelectedToolSourceRecord.TechnicalDetails, Mode=OneWay}" 
                                     Background="#0C0F17" Foreground="#00FFC2" BorderThickness="0" 
                                     IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="8" />
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Raw Hex Dump -->
                    <TabItem Header="🔢 Hex Dump">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedToolSourceRecord.PayloadHex, Mode=OneWay}" 
                                     Background="#0C0F17" Foreground="#00FFE5" BorderThickness="0" 
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="11" Padding="8" />
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: ASCII Representation -->
                    <TabItem Header="🔤 نصوص البايتات (ASCII)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox Text="{Binding SelectedToolSourceRecord.PayloadAscii, Mode=OneWay}" 
                                     Background="#0C0F17" Foreground="#FFE082" BorderThickness="0" 
                                     IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="8" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
