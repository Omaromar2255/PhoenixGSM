<UserControl x:Class="PhoenixGSM.MonitoringStudio.Views.Components.EventsGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="1200">
    <Border Background="{StaticResource CardBgBrush}" 
            BorderBrush="{StaticResource BorderDarkBrush}" 
            BorderThickness="1" 
            CornerRadius="8">
        <Grid>
            <DataGrid x:Name="EventsDataGrid"
                      PreviewMouseWheel="EventsDataGrid_PreviewMouseWheel"
                      ScrollViewer.ScrollChanged="EventsDataGrid_ScrollChanged"
                      ItemsSource="{Binding FilteredEvents}"
                      SelectedItem="{Binding SelectedEvent}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1F2436"
                      Background="Transparent"
                      RowBackground="#151824"
                      AlternatingRowBackground="#181C2B"
                      Foreground="#E0E6ED"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      FontFamily="Consolas, Segoe UI"
                      FontSize="11.5"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#10121C" />
                        <Setter Property="Foreground" Value="#00E5FF" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="BorderBrush" Value="#22283A" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🗑️ مسح وتنظيف السجلات (Clear All Logs)" 
                                  InputGestureText="Ctrl+L"
                                  Command="{Binding ClearLogsCommand}" />
                        <Separator />
                        <MenuItem Header="التمرير التلقائي لآخر سطر (Auto-scroll to bottom)" 
                                  IsCheckable="True"
                                  IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="إخفاء السجلات المشابهة (Hide similar)" 
                                  Command="{Binding HideSelectedSourceTagCommand}" />
                        <MenuItem Header="إظهار السجلات المخفية فقط (Show hidden only)" 
                                  IsCheckable="True"
                                  IsChecked="{Binding ShowHiddenLogsOnly, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="إلغاء جميع الاستثناءات (Reset exclusions)" 
                                  Command="{Binding ResetExclusionsCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="24" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#20263A" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#003554" />
                            <Setter Property="BorderBrush" Value="#00E5FF" />
                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Timestamp -->
                <DataGridTextColumn Header="TIME" Binding="{Binding TimeFormatted}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8E9AA8" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Source Badge -->
                <DataGridTemplateColumn Header="SOURCE" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BadgeBackground}" 
                                    CornerRadius="3" Padding="6,1" Margin="4,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SourceTag}" 
                                           Foreground="{Binding BadgeForeground}" 
                                           FontWeight="Bold" FontSize="10" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Direction -->
                <DataGridTextColumn Header="DIR" Binding="{Binding Direction}" Width="55">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding DirectionForeground}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Target / Port / Tool -->
                <DataGridTextColumn Header="TARGET / PORT" Binding="{Binding EndpointOrTarget}" Width="135">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFB800" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding EndpointOrTarget}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Protocol -->
                <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8E9AA8" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Command -->
                <DataGridTextColumn Header="COMMAND" Binding="{Binding Command}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#00FF9D" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Command}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Event Summary / Payload Preview -->
                <DataGridTextColumn Header="SUMMARY &amp; PAYLOAD" Binding="{Binding Summary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Summary}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Floating Jump-to-Bottom & Resume Banner (Shown when AutoScroll is paused) -->
        <Border Visibility="{Binding IsAutoScrollPaused, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,20"
                Background="#111624" BorderBrush="#00E5FF" BorderThickness="1.5"
                CornerRadius="16" Padding="6,3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" Color="#000000" />
            </Border.Effect>
            <Button Command="{Binding ResumeAutoScrollCommand}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="التمرير التلقائي متوقف • انقر للانتقال لآخر سطر واستئناف" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center" />
                    <Border Background="#1C382F" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" FontWeight="Bold" FontSize="9" Foreground="#00FF9D" />
                    </Border>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Border>
</UserControl>
