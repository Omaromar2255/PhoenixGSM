<UserControl x:Class="PhoenixGSM.MonitoringStudio.Views.Components.InspectorDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="1200">
    <Border Background="{StaticResource CardBgBrush}" 
            BorderBrush="{StaticResource BorderDarkBrush}" 
            BorderThickness="1" 
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Inspector Action & Title Bar -->
                <RowDefinition Height="Auto" />
                <!-- Collapsible Inspector Content Area -->
                <RowDefinition x:Name="DrawerContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Action Toolbar -->
            <Border Grid.Row="0" Background="#141724" 
                    BorderBrush="{StaticResource BorderDarkBrush}" 
                    BorderThickness="0,0,0,1" 
                    CornerRadius="7,7,0,0" 
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Combined Title Headers -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 PACKET &amp; PROTOCOL METADATA" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                        <TextBlock Text=" │ " Foreground="#3A4460" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Text="📦 PAYLOAD &amp; STREAM DATA" FontSize="11" FontWeight="Bold" Foreground="#00FF9D" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋 Copy Text" Click="CopyText_Click" 
                                Style="{StaticResource ModernBtn}" Height="25" FontSize="10.5" Padding="8,2" Margin="0,0,6,0" />

                        <Button Content="🔣 Copy Hex Dump" Click="CopyHex_Click" 
                                Style="{StaticResource ModernBtn}" Height="25" FontSize="10.5" Padding="8,2" Margin="0,0,6,0" />

                        <Button x:Name="ToggleDrawerBtn" Content="🔽 Collapse Drawer" Click="ToggleDrawer_Click" 
                                Style="{StaticResource ModernBtn}" Height="25" FontSize="10.5" Padding="8,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Inspector Content (Left Metadata + Splitter + Right Dual Hex/Text) -->
            <Grid x:Name="DrawerContentGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Column: Protocol Metadata (Width 380, MinWidth 260) -->
                    <ColumnDefinition Width="380" MinWidth="260" />
                    <!-- Vertical Splitter -->
                    <ColumnDefinition Width="4" />
                    <!-- Right Column: Dual Payload (MinWidth 300) -->
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- METADATA CARD (LEFT) -->
                <Border Grid.Column="0" Background="#121521" Padding="10,8" CornerRadius="0,0,0,7">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Command -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Command:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEvent.Command, Mode=OneWay}" 
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         FontWeight="Bold" Foreground="#00FF9D" FontSize="11" 
                                         VerticalAlignment="Center" ToolTip="{Binding SelectedEvent.Command}" 
                                         SelectionBrush="#00E5FF" />
                            </Grid>

                            <!-- Source ➔ Target -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Source ➔ Target:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEvent.SourceTag}" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text=" ➔ " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedEvent.EndpointOrTarget}" Foreground="#FFC800" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- Protocol -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Protocol:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.Protocol}" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Direction -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Direction:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.Direction}" Foreground="{Binding SelectedEvent.DirectionForeground}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Time -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time (UTC/Local):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.TimeFormatted}" Foreground="#8E9AA8" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Additional Details -->
                            <TextBlock Text="Additional Details / Arguments:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,2" />
                            <TextBox Text="{Binding SelectedEvent.AdditionalDetails, Mode=OneWay}" 
                                     IsReadOnly="True" TextWrapping="Wrap" 
                                     Background="#0E101A" Foreground="#CAD3DE" BorderBrush="#252B3D" 
                                     FontFamily="Consolas" FontSize="11" Padding="6" MinHeight="85" MaxHeight="260" 
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#10121C" Cursor="SizeWE" />

                <!-- PAYLOAD INSPECTOR (RIGHT) -->
                <Grid Grid.Column="2" Margin="8,4,8,6">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#181B28" />
                                <Setter Property="Foreground" Value="#8E9AA8" />
                                <Setter Property="BorderBrush" Value="#2A3045" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#003554" />
                                        <Setter Property="Foreground" Value="#00E5FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- Tab 1: Clean ASCII / Text View -->
                        <TabItem Header="Decoded Text">
                            <TextBox Text="{Binding SelectedEvent.PayloadAscii, Mode=OneWay}" 
                                     IsReadOnly="True" TextWrapping="Wrap" 
                                     Background="#0B0D14" Foreground="#00FF9D" BorderBrush="#1F2436" 
                                     FontFamily="Consolas" FontSize="11.5" Padding="8" 
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </TabItem>

                        <!-- Tab 2: Wireshark / HxD Style Hex Dump -->
                        <TabItem Header="Hex Dump (Offset | Bytes | ASCII)">
                            <TextBox Text="{Binding SelectedEvent.PayloadHex, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="#0B0D14" Foreground="#CAD3DE" BorderBrush="#1F2436" 
                                     FontFamily="Consolas" FontSize="11.5" Padding="8" 
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
