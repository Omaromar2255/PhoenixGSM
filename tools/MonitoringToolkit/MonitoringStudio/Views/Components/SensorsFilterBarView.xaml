<UserControl x:Class="PhoenixGSM.MonitoringStudio.Views.Components.SensorsFilterBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:PhoenixGSM.MonitoringStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="125" d:DesignWidth="1250">

    <UserControl.Resources>
        <!-- Reusable Chip Category Button Style -->
        <Style x:Key="ChipCategoryBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable High-Density Micro Toggle Switch -->
        <Style x:Key="MicroToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#171C28" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="BorderBrush" Value="#2F364B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="19" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tgBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tgBorder" Property="Background" Value="#0E2E25" />
                                <Setter TargetName="tgBorder" Property="BorderBrush" Value="#00FF9D" />
                                <Setter Property="Foreground" Value="#00FF9D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tgBorder" Property="BorderBrush" Value="#00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Ultra-Sleek Space-Saving Card Container -->
    <Border Background="{StaticResource CardBgBrush}" 
            BorderBrush="{StaticResource BorderDarkBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="10,7" 
            Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header & Controls Row (~28px) -->
                <RowDefinition Height="Auto" />
                <!-- 1: High-Density Category / Sensor Filter Chips (~58px) -->
                <RowDefinition Height="Auto" />
                <!-- 2: Exclusions Toolbar Sub-Row (~24px) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- ROW 0: HEADER & MASTER CONTROLS                            -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <!-- Icon & Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Master Enable/Disable All -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Search Filter Box -->
                    <ColumnDefinition Width="220" />
                    <!-- Auto-Scroll CheckBox -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Section Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Unified Sensors &amp; Categories" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                    <TextBlock Text="(Live Capture Matrix)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Micro Buttons: Enable All / Disable All -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="✅ Enable All" Command="{Binding EnableAllSensorsCommand}" 
                            Style="{StaticResource ModernBtn}" Height="24" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" />
                    <Button Content="⏹️ Disable All" Command="{Binding DisableAllSensorsCommand}" 
                            Style="{StaticResource ModernBtn}" Height="24" Padding="8,2" FontSize="10.5" />
                </StackPanel>

                <!-- Watermarked Search Filter Box -->
                <Grid Grid.Column="3" Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#0C0F17" Foreground="#FFFFFF" BorderBrush="#2A3347" 
                             CaretBrush="#00E5FF" Padding="7,3" FontSize="11" Height="24" VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="🔍 Filter events..." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Auto-Scroll CheckBox -->
                <CheckBox Grid.Column="4" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                          ToolTip="تفعيل أو إيقاف التمرير التلقائي لآخر سطر عند وصول سجلات جديدة">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutoScrollIcon}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="📜 التمرير التلقائي (Auto-Scroll)" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AutoScrollStatusColor}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- ROW 1: HIGH-DENSITY CATEGORIES & SENSORS CHIPS             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="-3,0,-3,6">

                <!-- 1. 🌐 All Events Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                    <Setter Property="Background" Value="#0D2A38" />
                                    <Setter Property="BorderBrush" Value="#00E5FF" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                            Style="{StaticResource ChipCategoryBtn}" ToolTip="عرض كافة السجلات الجنائية الشاملة (Show all forensic events)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <TextBlock Text="🌐 الكل (All)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalEventsCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 1.5 📱 Phone Commands Chip (أوامر الهاتف فقط - Host to Device Pipeline) -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#00FFC2" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPhoneCommandsSelected}" Value="True">
                                    <Setter Property="Background" Value="#0A2E22" />
                                    <Setter Property="BorderBrush" Value="#00FFC2" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SelectCategoryCommand}" CommandParameter="PhoneCommands"
                            Style="{StaticResource ChipCategoryBtn}" ToolTip="عرض الأوامر الموجهة للهاتف فقط (Host ➔ Device Pure Pipeline)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <TextBlock Text="📱 أوامر الهاتف (Phone)" Foreground="#00FFC2" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="#0E121D" BorderBrush="#00FFC2" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PhoneCommandsCount}" FontSize="10" FontWeight="Bold" Foreground="#00FFC2" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 2. 🔌 USB Driver Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsUsbDriverSelected}" Value="True">
                                    <Setter Property="Background" Value="#0D2A38" />
                                    <Setter Property="BorderBrush" Value="#00E5FF" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="UsbDriver"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by USB Driver events">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔌 USB" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UsbCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsUsbMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle USB Driver Interception (ON/OFF)">
                            <TextBlock Text="{Binding UsbMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 3. 🤖 ADB Proxy Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAdbProxySelected}" Value="True">
                                    <Setter Property="Background" Value="#0A2B1D" />
                                    <Setter Property="BorderBrush" Value="#00FF9D" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="AdbProxy"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by ADB Proxy events">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🤖 ADB" Foreground="#00FF9D" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AdbCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsAdbMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle ADB Proxy Interception (ON/OFF)">
                            <TextBlock Text="{Binding AdbMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 4. 📟 COM / AT Serial Port Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSerialPortSelected}" Value="True">
                                    <Setter Property="Background" Value="#2E2205" />
                                    <Setter Property="BorderBrush" Value="#FFB800" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="SerialPort"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by Serial / Modem Port COM events">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📟 COM/AT" Foreground="#FFB800" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SerialCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsSerialMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle COM/AT Serial Interception (ON/OFF)">
                            <TextBlock Text="{Binding SerialMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 5. ⚙️ Tools (Process) Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsProcessSelected}" Value="True">
                                    <Setter Property="Background" Value="#261338" />
                                    <Setter Property="BorderBrush" Value="#C084FC" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Process"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by GSM Repair Tools process activity">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️ Tools" Foreground="#C084FC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProcessCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsProcessMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Tools Process Interception (ON/OFF)">
                            <TextBlock Text="{Binding ProcessMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 6. 🖥️ CMD Executions Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCmdSelected}" Value="True">
                                    <Setter Property="Background" Value="#262B35" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Cmd"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by Command Line (CMD) executions">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖥️ CMD" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CmdCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsCmdMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle CMD Execution Interception (ON/OFF)">
                            <TextBlock Text="{Binding CmdMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 7. 🐚 Shell Commands Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsShellSelected}" Value="True">
                                    <Setter Property="Background" Value="#14291B" />
                                    <Setter Property="BorderBrush" Value="#A5D6A7" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Shell"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by Shell / Terminal command events">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🐚 Shell" Foreground="#A5D6A7" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShellCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsShellMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Shell Interception (ON/OFF)">
                            <TextBlock Text="{Binding ShellMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 8. 🌐 Web / URLs Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsNetworkUrlSelected}" Value="True">
                                    <Setter Property="Background" Value="#330E17" />
                                    <Setter Property="BorderBrush" Value="#F43F5E" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="NetworkUrl"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter by Web &amp; API URLs">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐 URLs" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NetworkCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsUrlMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Web &amp; URL Interception (ON/OFF)">
                            <TextBlock Text="{Binding UrlMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 9. ⚡ MTK (MediaTek) Chip [Auto-Capture] -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMediaTekSelected}" Value="True">
                                    <Setter Property="Background" Value="#331804" />
                                    <Setter Property="BorderBrush" Value="#FF6D00" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SelectCategoryCommand}" CommandParameter="MediaTek"
                            Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter MediaTek SoC traffic (Auto-capture)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <TextBlock Text="⚡ MTK" Foreground="#FF6D00" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MtkCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                            <Border Background="#1F140A" BorderBrush="#FF6D00" BorderThickness="0.5" CornerRadius="2" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUTO" FontSize="8.5" FontWeight="SemiBold" Foreground="#FF9E54" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 10. 💎 SPD (Unisoc) Chip [Auto-Capture] -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsUnisocSpdSelected}" Value="True">
                                    <Setter Property="Background" Value="#2B0E33" />
                                    <Setter Property="BorderBrush" Value="#E040FB" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SelectCategoryCommand}" CommandParameter="UnisocSpd"
                            Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter Unisoc/Spreadtrum traffic (Auto-capture)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <TextBlock Text="💎 SPD" Foreground="#E040FB" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SpdCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                            <Border Background="#1D0A23" BorderBrush="#E040FB" BorderThickness="0.5" CornerRadius="2" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUTO" FontSize="8.5" FontWeight="SemiBold" Foreground="#EA80FC" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 11. 🔥 EDL 9008 Chip [Auto-Capture] -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsQualcommEdlSelected}" Value="True">
                                    <Setter Property="Background" Value="#330A12" />
                                    <Setter Property="BorderBrush" Value="#FF1744" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SelectCategoryCommand}" CommandParameter="QualcommEdl"
                            Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter Qualcomm 9008 Emergency Download traffic (Auto-capture)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <TextBlock Text="🔥 EDL 9008" Foreground="#FF1744" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EdlCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                            <Border Background="#20060B" BorderBrush="#FF1744" BorderThickness="0.5" CornerRadius="2" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUTO" FontSize="8.5" FontWeight="SemiBold" Foreground="#FF5252" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 12. 🍎 Apple iOS Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAppleIosSelected}" Value="True">
                                    <Setter Property="Background" Value="#0A2438" />
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="AppleIos"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter Apple iOS (DFU/Recovery/MobileDevice) traffic">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍎 Apple" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppleCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsAppleMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Apple iOS Interception (ON/OFF)">
                            <TextBlock Text="{Binding AppleMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 13. 📁 Temp AT Files Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsTempFileAtSelected}" Value="True">
                                    <Setter Property="Background" Value="#331A0A" />
                                    <Setter Property="BorderBrush" Value="#FB923C" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="TempFileAt"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter temporary AT / modem command scripts">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 Temp AT" Foreground="#FB923C" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TempAtCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsTempAtMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Temp AT Scripts Interception (ON/OFF)">
                            <TextBlock Text="{Binding TempAtMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 14. 📁 MTP Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMtpSelected}" Value="True">
                                    <Setter Property="Background" Value="#092B28" />
                                    <Setter Property="BorderBrush" Value="#2DD4BF" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Mtp"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter Media Transfer Protocol (MTP) storage events">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 MTP" Foreground="#2DD4BF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MtpCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsMtpMonitoringEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle MTP Storage Interception (ON/OFF)">
                            <TextBlock Text="{Binding MtpMonitoringStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- 15. 📦 Artifact Vault Files Chip -->
                <Border CornerRadius="5" BorderThickness="1" Margin="3,2" Height="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#171C28" />
                            <Setter Property="BorderBrush" Value="#232B3B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#38455E" />
                                    <Setter Property="Background" Value="#1C2232" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsArtifactVaultSelected}" Value="True">
                                    <Setter Property="Background" Value="#2B2308" />
                                    <Setter Property="BorderBrush" Value="#FBBF24" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="ArtifactVault"
                                Style="{StaticResource ChipCategoryBtn}" ToolTip="Filter Captured Artifact Vault forensic dumps">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 Vault" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#0E121D" BorderBrush="#252E42" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ArtifactVaultCount}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsArtifactVaultEnabled}" Style="{StaticResource MicroToggleBtn}" ToolTip="Toggle Artifact Vault Recording (ON/OFF)">
                            <TextBlock Text="{Binding ArtifactVaultStatusText}" FontSize="9" FontWeight="Bold" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- ROW 2: HIGH-DENSITY EXCLUSIONS TOOLBAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#10141F" BorderBrush="#1F2636" BorderThickness="0,1,0,0" Padding="4,4,4,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Exclude Label -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Horizontal Exclusion Pills -->
                        <ColumnDefinition Width="*" />
                        <!-- Status Badge & Reset Button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Section Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="🛡️ Exclude from View/Export:" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF758F" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Horizontal Scrollable Exclusion Filters -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding HideUrls}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 URLs" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideAdb}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 ADB" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideUsb}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 USB" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideSerial}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 COM" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideProcesses}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 Tools" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideCmd}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 CMD" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideShell}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 Shell" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideTempAt}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 AT Files" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideApple}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 Apple" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideMtp}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 MTP" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding HideArtifacts}" Style="{StaticResource ExclusionCheckBox}">
                                <TextBlock Text="🚫 Vault" />
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Exclusion Status Badge & Reset Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Border Background="#25121A" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ExclusionBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#FFA4B4" VerticalAlignment="Center" />
                        </Border>

                        <Button Content="Reset Exclusions" Command="{Binding ResetExclusionsCommand}" 
                                Style="{StaticResource RedActionBtn}" Height="22" Padding="7,1" FontSize="10"
                                IsEnabled="{Binding HasActiveExclusions}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
