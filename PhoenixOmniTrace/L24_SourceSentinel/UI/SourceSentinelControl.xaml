<UserControl x:Class="PhoenixOmniTrace.L24_SourceSentinel.UI.SourceSentinelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PhoenixOmniTrace.L24_SourceSentinel.UI"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1360"
             Background="#0B0E14" Foreground="#E2E8F0">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SourceSentinelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60*" MinHeight="220" />
            <RowDefinition Height="6" />
            <RowDefinition Height="40*" MinHeight="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP CONTROL & DISCOVERY MODE TOOLBAR -->
        <Border Grid.Row="0" Background="#111622" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="L24 Source Sentinel" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                <Border Background="#1C382F" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="MULTI-VECTOR PRE-EXECUTION + SMART RAM HUNTER + AUTO BOOT/LOADER ARCHIVER" FontSize="9" FontWeight="Bold" Foreground="#00FF9D" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="اعتراض الأوامر من الأداة قبل وأثناء التنفيذ (CMD/Shell/PTY/Sockets) + اكتشاف الرام مع عزل الخمول + حفظ تلقائي لملفات البوت واللودر" 
                                       FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- زر التحكم الرئيسي لتشغيل أو إيقاف الطبقة L24 بالكامل وتوفير موارد الجهاز -->
                        <Button Command="{Binding ToggleL24MasterCommand}"
                                Background="{Binding L24MasterButtonBackground}"
                                BorderBrush="{Binding L24MasterButtonBorder}"
                                Foreground="{Binding L24MasterStatusColor}"
                                Style="{StaticResource SentinelBtn}" 
                                Height="28" Padding="10,2" Margin="0,0,6,0"
                                ToolTip="{Binding L24MasterTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L24MasterButtonText}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="{Binding L24MasterBackground}" BorderBrush="{Binding L24MasterBorder}"
                                        BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L24MasterBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding L24MasterStatusColor}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- زر مستقل لإيقاف أو تشغيل فاحص الرام عند الحاجة لتوفير الأداء مع بقاء رصد الأوامر المنفذة يعمل 100% -->
                        <Button Content="{Binding RamHunterToggleButtonText}"
                                Command="{Binding ToggleRamHunterCommand}"
                                Background="{Binding RamHunterToggleBtnBackground}"
                                BorderBrush="{Binding RamHunterToggleBtnBorder}"
                                Style="{StaticResource SentinelBtn}"
                                Height="28" Padding="8,2" Margin="0,0,6,0"
                                ToolTip="إيقاف أو تشغيل فاحص الرام مؤقتاً عند الحاجة لتوفير الأداء والتركيز على التقاط الأوامر المنفذة بدقة 100%" />

                        <Button Content="🚀 تشغيل واعتراض أداة" 
                                Command="{Binding LaunchToolCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#0284C7" BorderBrush="#38BDF8" Margin="0,0,5,0" />

                        <Button Content="🔗 ربط بعملية (PID)" 
                                Command="{Binding AttachProcessCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#1E293B" BorderBrush="#475569" Margin="0,0,5,0" />

                        <Button Content="📜 تصدير السجل الخام" 
                                Command="{Binding ExportUnfilteredRawLogsCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#7C2D12" BorderBrush="#F97316" Margin="0,0,5,0" />

                        <Button Content="🗂️ تصدير الفئات" 
                                Command="{Binding ExportAllDiscoveredCategoriesSeparatelyCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#3B0764" BorderBrush="#A855F7" Margin="0,0,5,0" />

                        <Button Content="📂 الملفات المحفوظة" 
                                Command="{Binding OpenCapturedFilesFolderCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#065F46" BorderBrush="#10B981" Margin="0,0,5,0" />

                        <Button Content="📁 السجلات" 
                                Command="{Binding OpenLogsFolderCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#1E293B" BorderBrush="#334155" Margin="0,0,5,0" />

                        <Button Content="🗑️ مسح" 
                                Command="{Binding ClearEventsCommand}"
                                Style="{StaticResource SentinelBtn}" 
                                Background="#881337" BorderBrush="#F43F5E" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎯 نمط الرام:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox SelectedIndex="{Binding SelectedDiscoveryModeIndex, Mode=TwoWay}"
                                  Width="260" Height="25" FontSize="10.5"
                                  Background="#0F172A" Foreground="#0F172A" BorderBrush="#38BDF8" Margin="0,0,10,0">
                            <ComboBoxItem Content="⚡ المنفذة للهاتف فقط (إيقاف فحص الرام العام)" />
                            <ComboBoxItem Content="📱 المنفذة + أوامر الهاتف فقط بالرام (AT/MTK/QC/Apple/ADB)" />
                            <ComboBoxItem Content="🧠 اكتشاف شامل للرام (يشمل الروابط وتسجيل الدخول والملفات والكل)" />
                        </ComboBox>

                        <CheckBox Content="🛡️ عزل أوامر الخمول الثابتة (Idle Filter)"
                                  IsChecked="{Binding SuppressIdleStaticBaseline, Mode=TwoWay}"
                                  Foreground="#34D399" FontWeight="SemiBold" FontSize="11"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="يمنع ظهور النصوص الثابتة المخزنة داخل ملف الأداة في وضع الخمول (Idle) ويعرض فقط الأوامر التي تولدها الأداة أثناء العمل. ألغِ التحديد إذا أردت استخراج كافة نصوص الأداة الثابتة." />

                        <CheckBox Content="⚡ فحص الـ Heap النشط فقط"
                                  IsChecked="{Binding ScanDynamicHeapOnly, Mode=TwoWay}"
                                  Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="يحصر فحص الرام في مناطق الذاكرة الديناميكية القابلة للكتابة فقط لسرعة فائقة (أقل من 150ms)" />

                        <Button Content="📸 تصفير/التقاط الخمول الآن"
                                Command="{Binding CaptureIdleBaselineCommand}"
                                Style="{StaticResource SentinelBtn}"
                                Background="#1E293B" BorderBrush="#34D399" Padding="7,2" Margin="0,0,10,0" FontSize="10.5"
                                ToolTip="التقاط حالة الرام الحالية كبصمة خمول بحيث يظهر بعدها فقط ما يستجد من أوامر" />

                        <CheckBox Content="📥 رد الهاتف"
                                  IsChecked="{Binding ShowPhoneResponses, Mode=TwoWay}"
                                  Foreground="#00FFC2" FontWeight="SemiBold" FontSize="11"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                        <CheckBox Content="📜 السجل الخام"
                                  IsChecked="{Binding IsUnfilteredRawLoggingEnabled, Mode=TwoWay}"
                                  Foreground="#F97316" FontWeight="SemiBold" FontSize="11"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#3B0764" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="5" 
                                Padding="6,2" VerticalAlignment="Center"
                                Visibility="{Binding IsOriginFilterActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveOriginFilter, StringFormat='🎯 مصدر محدد: {0}'}" FontSize="10.5" Foreground="#E9D5FF" VerticalAlignment="Center" />
                                <Button Content="✕" Command="{Binding ClearOriginFilterCommand}" Background="Transparent" BorderThickness="0" Foreground="#F43F5E" FontWeight="Bold" Margin="6,0,0,0" Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,5,0" FontSize="11" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="175" Height="25" VerticalContentAlignment="Center"
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,2" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 5-TAB WORKSPACE (4 ISOLATED TABS + 1 UNFILTERED RAW EVERYTHING TAB) -->
        <TabControl Grid.Row="1" Background="#111622" BorderBrush="#1E293B" BorderThickness="1" Padding="4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#0F172A" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#1E293B" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1E3A5F" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                                        <Setter Property="Foreground" Value="#38BDF8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- التبويب 1: الأوامر الفعلية المنفذة للجهاز -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ الأوامر الفعلية المنفذة للجهاز (" />
                        <TextBlock Text="{Binding ExecutedCommandsCount}" Foreground="#00FFC2" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredExecutedEvents}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" Background="#0D111A"
                              RowBackground="#111622" AlternatingRowBackground="#0D111A"
                              BorderThickness="0" Foreground="#E2E8F0" FontSize="11.5" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding FormattedTimestamp}" Width="90" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding CommandGroupBadge}" Width="175" />
                            <DataGridTextColumn Header="المصدر الفعلي" Binding="{Binding CallerModuleOrigin}" Width="170" />
                            <DataGridTextColumn Header="المنفذ / الهدف" Binding="{Binding TargetResource}" Width="170" />
                            <DataGridTextColumn Header="الأمر الصافي المنفذ" Binding="{Binding PureCommandText}" Width="240" />
                            <DataGridTextColumn Header="التفاصيل" Binding="{Binding DecodedCommandText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- التبويب 2: أوامر الهاتف الصافية للتجربة المباشرة -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱 أوامر الهاتف للتجربة (" />
                        <TextBlock Text="{Binding PurePhoneCommandsCount}" Foreground="#38BDF8" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredPurePhoneEvents}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" Background="#0D111A"
                              RowBackground="#111622" AlternatingRowBackground="#0D111A"
                              BorderThickness="0" Foreground="#E2E8F0" FontSize="11.5" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding FormattedTimestamp}" Width="90" />
                            <DataGridTextColumn Header="النطاق" Binding="{Binding ScopeBadge}" Width="135" />
                            <DataGridTextColumn Header="الفئة" Binding="{Binding CommandGroupBadge}" Width="185" />
                            <DataGridTextColumn Header="المنفذ / الهدف" Binding="{Binding TargetResource}" Width="165" />
                            <DataGridTextColumn Header="الأمر الجاهز للتجربة (انسخ وجرب)" Binding="{Binding PureCommandText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- التبويب 3: الأوامر المكتشفة في الذاكرة (مع فلترة الـ 10 أنواع) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧠 الأوامر المكتشفة في الذاكرة (" />
                        <TextBlock Text="{Binding DiscoveredRamCommandsCount}" Foreground="#FBBF24" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="{Binding DiscAllButtonText}" IsChecked="{Binding IsDiscAllSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="All"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                            <MenuItem Header="🚫 استثناء فئة الروابط من الرصد" Command="{Binding ExcludeUrlsCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscModemButtonText}" IsChecked="{Binding IsDiscModemSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="ModemAt"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد أوامر المودم" Command="{Binding ToggleCategoryCommand}" CommandParameter="ModemAt" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscMtkButtonText}" IsChecked="{Binding IsDiscMtkSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="MediaTek"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد أوامر MTK ميدياتك" Command="{Binding ToggleCategoryCommand}" CommandParameter="MediaTek" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscQualcommButtonText}" IsChecked="{Binding IsDiscQualcommSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="Qualcomm"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد أوامر كوالكوم EDL" Command="{Binding ToggleCategoryCommand}" CommandParameter="Qualcomm" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscAppleButtonText}" IsChecked="{Binding IsDiscAppleSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="AppleIos"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد أوامر أبل Apple" Command="{Binding ToggleCategoryCommand}" CommandParameter="AppleIos" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscAdbButtonText}" IsChecked="{Binding IsDiscAdbSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="AdbFastboot"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد أوامر ADB و Fastboot" Command="{Binding ToggleCategoryCommand}" CommandParameter="AdbFastboot" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscServerCloudButtonText}" IsChecked="{Binding IsDiscServerCloudSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="ServerCloudLogin"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد الروابط والخوادم" Command="{Binding ToggleCategoryCommand}" CommandParameter="ServerCloudLogin" />
                                            <MenuItem Header="🚫 استثناء فئة الروابط من الرصد فوراً" Command="{Binding ExcludeUrlsCommand}" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscTransferButtonText}" IsChecked="{Binding IsDiscTransferSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="FileTransfer"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد ملفات النقل واللودر" Command="{Binding ToggleCategoryCommand}" CommandParameter="FileTransfer" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscArchiveButtonText}" IsChecked="{Binding IsDiscArchiveSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="ArchiveUnpack"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد فك الضغط" Command="{Binding ToggleCategoryCommand}" CommandParameter="ArchiveUnpack" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscCryptoButtonText}" IsChecked="{Binding IsDiscCryptoSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="CryptoAuth"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد التشفير والمفاتيح" Command="{Binding ToggleCategoryCommand}" CommandParameter="CryptoAuth" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>

                                <RadioButton Content="{Binding DiscOtherButtonText}" IsChecked="{Binding IsDiscOtherSelected, Mode=OneWay}"
                                             Command="{Binding SetDiscoveredCategoryFilterCommand}" CommandParameter="OtherCommands"
                                             Style="{StaticResource FilterPillBtn}">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155">
                                            <MenuItem Header="⏸️/▶️ إيقاف أو تفعيل رصد الأوامر الأخرى" Command="{Binding ToggleCategoryCommand}" CommandParameter="OtherCommands" />
                                            <MenuItem Header="⚙️ فتح لوحة التحكم بجميع فئات الرصد" Command="{Binding ToggleCategoryConfigPanelCommand}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="🚫 استثناء الروابط"
                                          IsChecked="{Binding ExcludeUrlsFromDiscovered, Mode=TwoWay}"
                                          Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="استثناء الروابط والخوادم وتسجيل الدخول من الأوامر المكتشفة في الذاكرة" />

                                <Button Content="⚙️ فئات الرصد (إيقاف/تفعيل)"
                                        Command="{Binding ToggleCategoryConfigPanelCommand}"
                                        Style="{StaticResource SentinelBtn}"
                                        Background="#1E293B" BorderBrush="#38BDF8" Margin="0,0,8,0"
                                        ToolTip="إيقاف أو تفعيل أي فئة من فئات الرصد وتوفير موارد الجهاز" />

                                <Button Content="📤 تصدير الفئة المحددة فقط"
                                        Command="{Binding ExportSelectedDiscoveredCategoryCommand}"
                                        Style="{StaticResource SentinelBtn}"
                                        Background="#0E7490" BorderBrush="#22D3EE" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- لوحة التحكم وتخصيص تفعيل/إيقاف فئات الرصد بالذاكرة -->
                    <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,6"
                            Visibility="{Binding IsCategoryConfigPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ خيارات إيقاف وتفعيل فئات الرصد بالذاكرة (إلغاء التحديد يوقف رصد الفئة فوراً ويوفر موارد المعالج):"
                                               Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="تفعيل كافة الفئات" Command="{Binding EnableAllCategoriesCommand}" Style="{StaticResource SentinelBtn}" Background="#065F46" BorderBrush="#10B981" Margin="0,0,5,0" Padding="8,2" FontSize="10.5" />
                                    <Button Content="🚫 إيقاف الروابط فقط" Command="{Binding ExcludeUrlsCommand}" Style="{StaticResource SentinelBtn}" Background="#7C2D12" BorderBrush="#F97316" Margin="0,0,5,0" Padding="8,2" FontSize="10.5" />
                                    <Button Content="🔄 إلغاء بصمة الخمول وإظهار الكل" Command="{Binding ResetIdleBaselineCommand}" Style="{StaticResource SentinelBtn}" Background="#3B0764" BorderBrush="#A855F7" Margin="0,0,5,0" Padding="8,2" FontSize="10.5" />
                                    <Button Content="✕ إغلاق اللوحة" Command="{Binding ToggleCategoryConfigPanelCommand}" Style="{StaticResource SentinelBtn}" Background="#1E293B" BorderBrush="#475569" Padding="8,2" FontSize="10.5" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <CheckBox Content="📻 أوامر المودم (Modem / AT)" IsChecked="{Binding IsModemCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🔶 ميدياتك (MTK / BROM / DA)" IsChecked="{Binding IsMtkCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🔷 كوالكوم و EDL (Firehose)" IsChecked="{Binding IsQualcommCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🍎 أبل Apple (iOS / DFU / AFC)" IsChecked="{Binding IsAppleCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🤖 ADB / Fastboot / Shell" IsChecked="{Binding IsAdbCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🌐 الروابط والخوادم وتسجيل الدخول" IsChecked="{Binding IsServerCloudCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="📤 نقل وملفات بوت ولودر" IsChecked="{Binding IsTransferCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="📦 فك ضغط وتفكيك صور" IsChecked="{Binding IsArchiveCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🔐 تشفير ومفاتيح وبذور" IsChecked="{Binding IsCryptoCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                                <CheckBox Content="🧩 أوامر وعمليات أخرى" IsChecked="{Binding IsOtherCategoryEnabled, Mode=TwoWay}" Foreground="#F8FAFC" FontSize="11" Margin="0,3,16,3" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDiscoveredRamEvents}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" Background="#0D111A"
                              RowBackground="#111622" AlternatingRowBackground="#0D111A"
                              BorderThickness="0" Foreground="#E2E8F0" FontSize="11.5" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding FormattedTimestamp}" Width="88" />
                            <DataGridTextColumn Header="تصنيف الفلتر" Binding="{Binding CommandGroupBadge}" Width="195" />
                            <DataGridTextColumn Header="المصدر بالرام" Binding="{Binding CallerModuleOrigin}" Width="180" />
                            <DataGridTextColumn Header="الهدف / الملف المحفوظ" Binding="{Binding TargetResource}" Width="170" />
                            <DataGridTextColumn Header="الأمر / الرابط المكتشف الصافي" Binding="{Binding PureCommandText}" Width="260" />
                            <DataGridTextColumn Header="الوصف" Binding="{Binding DecodedCommandText}" Width="*" />
                            <DataGridTextColumn Header="الحجم" Binding="{Binding PayloadSize}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- التبويب 4: رادار المنافذ والملفات المحفوظة -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📡 رادار المنافذ والملفات المحفوظة (" />
                        <TextBlock Text="{Binding RadarEventsCount}" Foreground="#A855F7" />
                        <TextBlock Text=")" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <DataGrid ItemsSource="{Binding FilteredRadarEvents}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" Background="#0D111A"
                              RowBackground="#111622" AlternatingRowBackground="#0D111A"
                              BorderThickness="0" Foreground="#E2E8F0" FontSize="11.5" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding FormattedTimestamp}" Width="90" />
                            <DataGridTextColumn Header="المرحلة" Binding="{Binding StageBadge}" Width="135" />
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding CommandCategory}" Width="180" />
                            <DataGridTextColumn Header="مسار الحفظ / المنفذ" Binding="{Binding TargetResource}" Width="240" />
                            <DataGridTextColumn Header="التفاصيل" Binding="{Binding DecodedCommandText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- التبويب 5: السجل الشامل الخام بدون فلترة (Unfiltered Raw Everything Stream) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜 السجل الشامل الخام (" />
                        <TextBlock Text="{Binding UnfilteredRawEventsCount}" Foreground="#F97316" />
                        <TextBlock Text=")" Margin="0,0,6,0" />
                        <Border Background="{Binding UnfilteredRawStatusBackground}" BorderBrush="{Binding UnfilteredRawStatusBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnfilteredRawStatusText}" Foreground="{Binding UnfilteredRawStatusColor}" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Real-Time Control Bar for Raw Stream -->
                    <Border Grid.Row="0" Background="#0C121E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,5" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ التحكم الآني بالسجل الخام:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Border Background="{Binding UnfilteredRawStatusBackground}" BorderBrush="{Binding UnfilteredRawStatusBorder}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnfilteredRawStatusText}" Foreground="{Binding UnfilteredRawStatusColor}" FontWeight="Bold" FontSize="11" />
                                </Border>

                                <Button Content="{Binding UnfilteredRawToggleActionText}"
                                        Command="{Binding ToggleUnfilteredRawLoggingCommand}"
                                        Style="{StaticResource SentinelBtn}"
                                        Background="{Binding UnfilteredRawToggleBtnBackground}"
                                        BorderBrush="{Binding UnfilteredRawToggleBtnBorder}"
                                        Margin="0,0,8,0" Padding="10,3" FontSize="11" />

                                <CheckBox Content="🚫 استثناء الروابط من السجل الخام"
                                          IsChecked="{Binding ExcludeUrlsFromRawLog, Mode=TwoWay}"
                                          Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="استثناء الروابط واستدعاءات الخوادم من السجل الخام الشامل (مفعل افتراضياً)" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📜 تصدير السجل الخام" 
                                        Command="{Binding ExportUnfilteredRawLogsCommand}"
                                        Style="{StaticResource SentinelBtn}" 
                                        Background="#7C2D12" BorderBrush="#F97316" Margin="0,0,6,0" Padding="8,3" FontSize="10.5" />

                                <Button Content="🗑️ مسح المعروض بالسجل الخام" 
                                        Command="{Binding ClearUnfilteredRawCommand}"
                                        Style="{StaticResource SentinelBtn}" 
                                        Background="#1E293B" BorderBrush="#475569" Padding="8,3" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredUnfilteredRawEvents}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" Background="#0D111A"
                              RowBackground="#111622" AlternatingRowBackground="#0D111A"
                              BorderThickness="0" Foreground="#E2E8F0" FontSize="11.5" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding FormattedTimestamp}" Width="90" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                            <DataGridTextColumn Header="المرحلة" Binding="{Binding StageBadge}" Width="135" />
                            <DataGridTextColumn Header="الدالة / الحساس" Binding="{Binding HookedApiName}" Width="165" />
                            <DataGridTextColumn Header="المصدر" Binding="{Binding CallerModuleOrigin}" Width="175" />
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding CommandCategory}" Width="175" />
                            <DataGridTextColumn Header="النص الخام الصافي" Binding="{Binding PureCommandText}" Width="250" />
                            <DataGridTextColumn Header="التفاصيل الكاملة (بدون فلترة)" Binding="{Binding DecodedCommandText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#0B0E14" Cursor="SizeNS" ShowsPreview="True" />

        <!-- BOTTOM DUAL PANELS (RADAR & HEX INSPECTOR) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="62*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111622" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="💾 الملفات المحفوظة وملفات البوت واللودر" FontWeight="Bold" FontSize="12" Foreground="#A855F7" VerticalAlignment="Center" />
                        <Border Background="#2E1065" BorderBrush="#9333EA" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding LoadedArtifacts.Count, StringFormat='{}{0} عناصر'}" FontSize="10" Foreground="#D8B4FE" />
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredArtifacts}"
                             SelectedItem="{Binding SelectedArtifact}"
                             Background="#0B0E14" BorderBrush="#1E293B" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#131926" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModuleName}" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" />
                                        <TextBlock Text="{Binding FilePath}" Foreground="#64748B" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#0B0E14" Cursor="SizeWE" ShowsPreview="True" />

            <Border Grid.Column="2" Background="#111622" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔬 فاحص الحمولات الخام والأمر الصافي (Hex &amp; Pure Command Inspector)" FontWeight="Bold" FontSize="12" Foreground="#00FFC2" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#09101D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectedEventDetails}" FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Border>

                    <TextBox Grid.Row="2" 
                             Text="{Binding SelectedEventHexDump, Mode=OneWay}" 
                             IsReadOnly="True" FontFamily="Consolas" FontSize="11" 
                             Background="#080C14" Foreground="#38BDF8" BorderBrush="#1E293B" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" />
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS FOOTER -->
        <Border Grid.Row="4" Background="#111622" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ الحالة:" Foreground="#64748B" FontSize="11" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExecutedCommandsCount, StringFormat='⚡ منفذة: {0} | '}" Foreground="#00FFC2" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding PurePhoneCommandsCount, StringFormat='📱 للتجربة: {0} | '}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding DiscoveredRamCommandsCount, StringFormat='🧠 بالرام: {0} | '}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding RadarEventsCount, StringFormat='💾 ملفات/رادار: {0} | '}" Foreground="#A855F7" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding UnfilteredRawEventsCount, StringFormat='📜 السجل الخام الشامل: {0}'}" Foreground="#F97316" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
